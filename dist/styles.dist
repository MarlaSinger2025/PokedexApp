.modal-content,.pokemon-list{text-align:center}:root{--PokemonBlue:#3c5aa6;--PokemonYellow:#c7a008}body{background-color:#7591d8}.pokemon-list{list-style-type:none;padding-inline-start:0px}.pokemon-button{background-color:var(--PokemonBlue);border:none;color:#fff;padding:10px;border-radius:10px;margin:5px;width:20%;min-width:fit-content}.pokemon-button:hover{font-weight:700;border:3px solid #ffcb05}.container{margin-top:70px;padding-top:10px}.btn:hover{background-color:var(--PokemonYellow)}h1{font-family:Helvetica,Arial,sans-serif;color:var(--PokemonYellow);font-size:2rem;display:inline}@media screen and (min-width:576px) and (max-width:618px){.container{padding-top:45px}}@media screen and (max-width:575px){.container{padding-top:80px}}